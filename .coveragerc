[run]
omit =
    *python_commons*

[report]
# Regexes for lines to exclude from consideration
exclude_lines =
    # Have to re-enable the standard pragma
    pragma: no cover

    # Don't complain about unittest main
    unittest.main()

    # Don't bother with repr and dir
    def __repr__
    def __dir__

    # Don't bother with abstractmethods
    @abstractmethod
