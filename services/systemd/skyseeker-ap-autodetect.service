[Unit]
Description=SkySeeker USB rescue-AP interface auto-detect
After=NetworkManager.service
Before=skyseeker-standalone-net.service hostapd.service dnsmasq.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/skyseeker-ap-autodetect.sh

[Install]
WantedBy=multi-user.target
