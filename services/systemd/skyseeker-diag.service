[Unit]
Description=SkySeeker rescue diagnostics web page (out-of-band field status)
# Deliberately NOT tied to tricap: this must answer even if tricap has crashed.
After=network.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/bin/skyseeker-diag.py
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
