#!/usr/bin/env python3
"""Log-only health snapshot of the SkySeeker Wi-Fi AP, DHCP, and PCIe bus.

Step 2 of docs/stability-recovery-plan.md: every 15 seconds record what the
AP stack looks like so the next field failure ("AP visible but can't
connect") can be attributed to hostapd, the driver, or DHCP. This tool
OBSERVES ONLY - it never restarts services and never reboots. Recovery
authority is granted separately in later steps, justified by this data.
"""

import os
import re
import subprocess


SYSTEMCTL = "/bin/systemctl"
IP = "/usr/sbin/ip"
IW = "/usr/sbin/iw"
HOSTAPD_CLI = "/usr/sbin/hostapd_cli"
CONTROL_PATH = "/run/hostapd"
DMESG = "/bin/dmesg"


def run(args, timeout=6):
    try:
        return subprocess.run(
            args, capture_output=True, text=True, timeout=timeout, check=False
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return subprocess.CompletedProcess(args, 124, "", str(exc))


def unit_state(unit):
    result = run([SYSTEMCTL, "is-active", unit])
    return result.stdout.strip() or "unknown"


def find_ap_interface(iw_output):
    interface = None
    for raw in iw_output.splitlines():
        fields = raw.strip().split()
        if len(fields) == 2 and fields[0] == "Interface":
            interface = fields[1]
        elif fields == ["type", "AP"] and interface:
            return interface
    return None


def station_count(interface):
    result = run([IW, "dev", interface, "station", "dump"])
    if result.returncode:
        return -1
    return len(re.findall(r"^Station ", result.stdout, flags=re.M))


def link_up(interface):
    result = run([IP, "-o", "link", "show", "dev", interface])
    return result.returncode == 0 and bool(re.search(r"<[^>]*\bUP\b[^>]*>", result.stdout))


def hostapd_control_state(interface):
    """State via hostapd's control socket; 'absent' until step 4 enables it.

    'absent' is expected and healthy for now - it must never be read as an
    AP failure, or the data collected before step 4 lands is garbage.
    """
    if not os.path.exists(os.path.join(CONTROL_PATH, interface)):
        return "absent"
    result = run([HOSTAPD_CLI, "-p", CONTROL_PATH, "-i", interface, "ping"])
    if result.returncode or result.stdout.strip() != "PONG":
        return "ping-failed"
    result = run([HOSTAPD_CLI, "-p", CONTROL_PATH, "-i", interface, "status"])
    for line in result.stdout.splitlines():
        if line.startswith("state="):
            return line.split("=", 1)[1]
    return "no-state"


def pcie_error_count():
    result = run([DMESG], timeout=10)
    if result.returncode:
        return -1
    pattern = re.compile(r"pcie bus error|aer:|nvme.*(error|fail|timeout)", re.I)
    return sum(1 for line in result.stdout.splitlines() if pattern.search(line))


def main():
    hostapd = unit_state("hostapd.service")
    dnsmasq = unit_state("dnsmasq.service")

    iw_result = run([IW, "dev"])
    interface = find_ap_interface(iw_result.stdout) if iw_result.returncode == 0 else None

    if interface:
        summary = (
            f"iface={interface}"
            f" link={'UP' if link_up(interface) else 'DOWN'}"
            f" stations={station_count(interface)}"
            f" ctrl={hostapd_control_state(interface)}"
        )
    else:
        summary = "iface=NONE (no AP interface reported by the Wi-Fi driver)"

    print(
        f"ap-monitor: {summary}"
        f" hostapd={hostapd} dnsmasq={dnsmasq} pcie_err={pcie_error_count()}",
        flush=True,
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
