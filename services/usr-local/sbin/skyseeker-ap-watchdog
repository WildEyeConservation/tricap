#!/usr/bin/env python3
"""Recover a SkySeeker AP whose userspace or driver path stops responding."""

import json
import os
from pathlib import Path
import re
import subprocess
import time


SYSTEMCTL = "/bin/systemctl"
IP = "/usr/sbin/ip"
IW = "/usr/sbin/iw"
HOSTAPD_CLI = "/usr/sbin/hostapd_cli"
CONTROL_PATH = "/run/hostapd"
STATE_PATH = Path("/run/skyseeker-ap-watchdog.state")
DISABLE_PATH = Path("/run/skyseeker-ap-watchdog.disabled")
FAILURES_BEFORE_RESTART = 3
RESTART_SETTLE_SECONDS = 3


def run(args, timeout=6):
    try:
        return subprocess.run(
            args, capture_output=True, text=True, timeout=timeout, check=False
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return subprocess.CompletedProcess(args, 124, "", str(exc))


def find_ap_interface(iw_output):
    interface = None
    for raw in iw_output.splitlines():
        fields = raw.strip().split()
        if len(fields) == 2 and fields[0] == "Interface":
            interface = fields[1]
        elif len(fields) == 2 and fields == ["type", "AP"] and interface:
            return interface
    return None


def ap_health():
    result = run([SYSTEMCTL, "is-active", "--quiet", "hostapd.service"])
    if result.returncode:
        return False, "hostapd service is not active"

    result = run([IW, "dev"])
    interface = find_ap_interface(result.stdout) if result.returncode == 0 else None
    if not interface:
        return False, "no AP interface reported by the Wi-Fi driver"

    result = run([IP, "-o", "link", "show", "dev", interface])
    if result.returncode or not re.search(r"<[^>]*\bUP\b[^>]*>", result.stdout):
        return False, f"AP interface {interface} is not up"

    result = run([IW, "dev", interface, "info"])
    if result.returncode or "\n\ttype AP\n" not in "\n" + result.stdout:
        return False, f"Wi-Fi driver does not report {interface} in AP mode"

    result = run([HOSTAPD_CLI, "-p", CONTROL_PATH, "-i", interface, "ping"])
    if result.returncode or result.stdout.strip() != "PONG":
        return False, "hostapd control ping failed"

    result = run([HOSTAPD_CLI, "-p", CONTROL_PATH, "-i", interface, "status"])
    if result.returncode or "state=ENABLED" not in result.stdout.splitlines():
        return False, "hostapd does not report ENABLED"

    return True, f"AP {interface} is responsive"


def load_state():
    try:
        state = json.loads(STATE_PATH.read_text(encoding="utf-8"))
        return {
            "failures": max(0, int(state.get("failures", 0))),
            "restarted": bool(state.get("restarted", False)),
        }
    except (OSError, ValueError, TypeError):
        return {"failures": 0, "restarted": False}


def save_state(state):
    temporary = STATE_PATH.with_suffix(".tmp")
    temporary.write_text(json.dumps(state), encoding="utf-8")
    os.replace(temporary, STATE_PATH)


def clear_state():
    try:
        STATE_PATH.unlink()
    except FileNotFoundError:
        pass


def main():
    if DISABLE_PATH.exists():
        print(f"AP watchdog disabled by {DISABLE_PATH}", flush=True)
        return 0

    healthy, detail = ap_health()
    state = load_state()
    if healthy:
        if state["failures"] or state["restarted"]:
            print(f"AP recovered: {detail}", flush=True)
        clear_state()
        return 0

    if state["restarted"]:
        print(f"AP still unhealthy after hostapd restart: {detail}; rebooting", flush=True)
        run([SYSTEMCTL, "reboot"], timeout=15)
        return 0

    failures = state["failures"] + 1
    if failures < FAILURES_BEFORE_RESTART:
        save_state({"failures": failures, "restarted": False})
        print(
            f"AP health failure {failures}/{FAILURES_BEFORE_RESTART}: {detail}",
            flush=True,
        )
        return 0

    print(f"AP failed {failures} consecutive checks: {detail}; restarting hostapd", flush=True)
    result = run([SYSTEMCTL, "restart", "hostapd.service"], timeout=15)
    time.sleep(RESTART_SETTLE_SECONDS)
    healthy, recovery_detail = ap_health()
    if result.returncode == 0 and healthy:
        clear_state()
        print(f"AP recovered after hostapd restart: {recovery_detail}", flush=True)
    else:
        save_state({"failures": failures, "restarted": True})
        print(
            f"AP restart did not restore health: {recovery_detail}; will reboot if next check fails",
            flush=True,
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
