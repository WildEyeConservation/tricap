# Copy to /etc/systemd/system
[Unit]
Description=Tricap Launcher
After=network-online.target
Wants=network-online.target

[Service]
User=root
Restart=always
RestartSec=5
WorkingDirectory=/home/radxa/tricap
ExecStart=/usr/bin/python3 /home/radxa/tricap/tricap.py

[Install]
WantedBy=multi-user.target
